# ---------------------------------------------------------------------------
# xSender — copy to .env.local and fill in. Never commit the filled version.
# ---------------------------------------------------------------------------

# Supabase · Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the app is reachable; used for auth redirects and Meta webhook callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts channel access tokens at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Only needed where no worker process runs and pg_cron drains the queue over
# HTTP instead (see supabase/migrations/0010_queue_cron.sql). Must match the
# 'queue_drain_secret' stored in Supabase Vault. Leave blank if you run the
# worker — /api/jobs/drain then returns 503 rather than accepting calls.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QUEUE_DRAIN_SECRET=

# ---------------------------------------------------------------------------
# Meta / WhatsApp Cloud API (Phase 5a)
#
# Leave blank until you connect a real number: /api/webhooks/meta returns 503
# rather than accepting unauthenticated calls, and nothing else needs them.
# ---------------------------------------------------------------------------

# App Dashboard → Settings → Basic → App Secret. Signs every webhook delivery.
META_APP_SECRET=

# Any random string you choose. Meta echoes it back during the webhook
# subscription handshake; paste the same value into the Meta dashboard.
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
META_WEBHOOK_VERIFY_TOKEN=

# Pin the Graph API version so Meta's releases cannot change behaviour under you.
META_GRAPH_VERSION=v21.0
